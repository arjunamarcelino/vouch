# =============================================================================
# LOCAL SIMULATION ONLY — Chainlink CRE (`cre workflow simulate`)
# =============================================================================
# WARNING: These values are ONLY for local `cre workflow simulate`. In staging/
# production the corresponding secrets are released by the Vault DON and injected
# INSIDE the enclave — they never live in a .env and never touch node memory.
#
# CRITICAL (plan §17.6-H3): private test criteria and pass/fail thresholds must
# NEVER be inlined in workflow source or committed. They are fetched at runtime
# via the Vault DON. This template only names the local-sim env vars; put real
# values in a git-ignored .env for simulation and nowhere else.
#
# Copy this file to `.env` (git-ignored) for local simulation.

# Credential used by the confidential HTTP fetch ({{.token}} injection).
REPO_TOKEN_ENV=

# Reference/pointer to the PRIVATE regression test artifact/criteria.
PRIVATE_TEST_REF_ENV=

# Pass/fail threshold (local sim only — real value comes from the Vault DON).
PASS_THRESHOLD_ENV=

# RPC endpoints used by project.yaml during simulation.
ARC_TESTNET_RPC_URL=
SEPOLIA_RPC_URL=
