# =============================================================================
# LOCAL SIMULATION ONLY — Chainlink CRE (`cre workflow simulate`)
# =============================================================================
# WARNING: These values are ONLY for local `cre workflow simulate`. In staging/
# production the corresponding secrets are released by the Vault DON and injected
# INSIDE the enclave — they never live in a .env and never touch node memory.
#
# CRITICAL (plan §3, §9): private test criteria and pass/fail thresholds must
# NEVER be inlined in workflow source or committed. This template only names the
# local-sim env vars. Use HIGH-ENTROPY SENTINEL values in your git-ignored .env
# so the blocking pattern gate can prove no real secret leaked into evidence.
#
# Copy this file to `.env` (git-ignored) for local simulation.

# Credential used by the confidential HTTP fetch ({{.token}} injection).
REPO_TOKEN_ENV=SENTINEL_TOKEN_1a2b3c4d5e6f70819a0b1c2d3e4f5061

# Private pass/fail threshold (local sim only — real value comes from the Vault DON).
# Must be a finite number in [0,1]; a missing/empty/NaN value fails CLOSED (REFUSE).
PASS_THRESHOLD_ENV=0.9

# Reference/pointer that selects the PRIVATE regression suite in the request.
PRIVATE_TEST_REF_ENV=SENTINEL_TEST_REF_deadc0debaadf00dfeedface5a5a5a5a

# RPC endpoint used by project.yaml during simulation.
ARC_TESTNET_RPC_URL=
