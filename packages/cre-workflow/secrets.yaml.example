# Chainlink CRE — secrets manifest TEMPLATE (plan §17.2, §17.6-H3)
#
# Copy this file to `secrets.yaml` (git-ignored — the root .gitignore already
# ignores packages/cre-workflow/secrets.yaml) and provision with:
#   cre secrets create secrets.yaml
#
# This maps secret NAMES to the ENV VAR NAMES that hold them — NEVER the values.
# The actual values are released by the Vault DON and injected inside the
# enclave at runtime. Private test criteria and thresholds must never be inlined
# in workflow source (plan §17.6-H3).

secretsNames:
  # GitHub / repo credential used for the confidential HTTP fetch ({{.token}}).
  REPO_TOKEN:
    - REPO_TOKEN_ENV
  # Reference/pointer to the PRIVATE regression test artifact/criteria.
  PRIVATE_TEST_REF:
    - PRIVATE_TEST_REF_ENV
  # Pass/fail threshold — private, fetched at runtime, never hard-coded.
  PASS_THRESHOLD:
    - PASS_THRESHOLD_ENV
