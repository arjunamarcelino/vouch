# Chainlink CRE — secrets manifest TEMPLATE (plan §9).
#
# Copy this file to `secrets.yaml` (git-ignored — the root .gitignore already
# ignores packages/cre-workflow/secrets.yaml) and provision with:
#   cre secrets create secrets.yaml --target staging-settings
#
# This maps secret NAMES to the ENV VAR NAMES that hold them — NEVER the values.
# The actual values are released by the Vault DON and injected INSIDE the
# enclave at runtime. Private test criteria and thresholds must never be inlined
# in workflow source (plan §3, §9).

secretsNames:
  # Repo/API credential used for the confidential HTTP fetch ({{.token}}).
  token:
    - REPO_TOKEN_ENV
  # Private pass/fail threshold — fetched at runtime via getSecret, never inlined.
  PASS_THRESHOLD:
    - PASS_THRESHOLD_ENV
  # Reference/pointer that selects the PRIVATE regression suite in the request.
  PRIVATE_TEST_REF:
    - PRIVATE_TEST_REF_ENV
