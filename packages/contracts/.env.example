# packages/contracts — Foundry deployment env (NO REAL VALUES — template only)

# Arc testnet JSON-RPC endpoint (referenced by [rpc_endpoints].arc_testnet in foundry.toml)
ARC_TESTNET_RPC_URL=

# 6-decimal USDC ERC-20 address on the target chain (Arc testnet)
USDC_ADDRESS=

# Authorized DON-report transport: canonical KeystoneForwarder, or a relay/verifier
# address (see plan §17.3 — trust the DON signature, not the caller).
KEYSTONE_FORWARDER=

# Coverage window duration in seconds (e.g. 86400 = 24h)
COVERAGE_WINDOW=86400

# Funding window duration in seconds (optional; Deploy.s.sol defaults to 86400 = 1 day)
FUNDING_WINDOW=86400

# Deployer private key (LOCAL/TESTNET ONLY — never commit a real key)
DEPLOYER_PK=
