# =============================================================================
# @vouch/contracts — Arc deployment env template. NEVER commit real values.
# `forge script script/Deploy.s.sol:Deploy` reads these; missing values FAIL LOUDLY
# (vm.envAddress reverts) — the deploy never inserts a guessed address (plan §5/§9/§19).
# =============================================================================

# Arc testnet RPC. ⚠️ Host conflict: rpc.testnet.arc.io (docs.arc.io) vs
# rpc.testnet.arc.network (Circle skill). Confirm before use.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Canonical Arc USDC predeploy (6-decimal ERC-20 interface). Deploy asserts == this + has code.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# CRE report transport: a KeystoneForwarder contract OR an authorized relay EOA.
# ⚠️ No verified onchain KeystoneForwarder exists on Arc testnet — operator must supply one
# (simulation forwarder or agent relay). Deploy aborts if unset. See ADR-005 trust notes.
CRE_FORWARDER_ADDRESS=

# CRE workflow identity gate (bound in onReport). NAME is bytes10 (0x + 20 hex, right-padded).
CRE_WORKFLOW_ID=
CRE_WORKFLOW_NAME=
CRE_WORKFLOW_OWNER=

# Roles + fee routing. Admin holds DEFAULT_ADMIN_ROLE (pause/config); evaluator resolves
# public submissions; feeRecipient receives the optional service fee. Use a multisig for admin.
ADMIN_ADDRESS=
EVALUATOR_ADDRESS=
FEE_RECIPIENT_ADDRESS=

# Deployer key (use a keystore for anything real). Blockscout verify ignores the API key.
PRIVATE_KEY=
ARCSCAN_API_KEY=
