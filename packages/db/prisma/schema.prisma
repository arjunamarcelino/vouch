// Vouch offchain OPERATIONAL data store.
//
// Authoritative financial/reputation state lives ONCHAIN (Arc) + in The Graph.
// This Postgres schema is a rebuildable operational/UX layer only. It MUST NOT
// contain money-authoritative fields, reputation, private tests, evaluation
// criteria, repo credentials, or any secret material (plan §2.4 / §11 / §17.9).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Non-authoritative UI/orchestration metadata for a job. `cachedStatus` mirrors
/// onchain state ONE-DIRECTIONALLY (written only by the chain/subgraph poller,
/// never read to make money/reputation/authorization decisions — plan §17.9-F1).
model JobMetadata {
  /// Authoritative onchain job id (once JobCreated is indexed). Provisional rows
  /// before confirmation are keyed by clientRequestId and reconciled later.
  jobId           String?  @unique
  clientRequestId String   @id @default(uuid())
  /// Lowercased 0x parties (soft references — a provider may never have done SIWE,
  /// so NO FK to UserProfile). Backed by indexes for GET /jobs/mine.
  clientAddress   String?
  providerAddress String?
  uiTitle         String
  description     String   @default("")
  /// Opaque internal handle. NEVER a URL, credential, or token — the real repo
  /// location + creds are resolved only inside the CRE enclave (plan §17.9-F3).
  repoRef         String?
  /// Opaque reference to claim evidence. NEVER a preimage/URL/credential.
  evidenceRef     String?
  /// Nullable cache of onchain status. Display-only, best-effort, written ONE-
  /// directionally by the tracker; NEVER read for authz/money/state decisions.
  cachedStatus    String?
  lastSyncedBlock BigInt?
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notifications NotificationState[]
  agentRuns     AgentRunLog[]
  trackedTxs    TrackedTransaction[]
  feedEvents    FeedEvent[]

  @@index([clientAddress])
  @@index([providerAddress])
}

// =============================================================================
// apps/api operational store (Phase 0). Offchain/UX only — NEVER money,
// reputation, secrets, or preimages. Rebuildable. See docs/plans §Data ownership.
// =============================================================================

/// Offchain display profile keyed by lowercased wallet address. `kind` is a HINT
/// only — never drives authorization (roles come from chain hasRole / job party).
model UserProfile {
  address     String   @id // lowercased 0x (CHECK enforced in manual SQL)
  displayName String   @default("")
  kind        String? // CLIENT | PROVIDER | EVALUATOR — hint only
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Single-use SIWE nonce. Consumed via an atomic `UPDATE … WHERE consumed=false
/// AND expiresAt > now()` CAS (affected-rows === 1 is the lock). GC by expiresAt.
model SiweNonce {
  nonce      String    @id
  address    String? // bound at consume time (lowercased)
  consumed   Boolean   @default(false)
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([expiresAt])
}

/// Stripe-style idempotency record. Identity is (scope, route, key) — scope is the
/// lowercased session address (sentinel "public" for unauth'd writes) so keys are
/// caller-namespaced (no cross-tenant replay). `state` LOCKED|COMPLETED with a lease
/// so a crashed in-flight claim is reclaimable. `response` replays byte-exact.
model IdempotencyRecord {
  scope       String
  route       String
  key         String
  requestHash String // keccak256 of canonical method+route+body
  state       String   @default("LOCKED") // LOCKED | COMPLETED
  /// Random per-claim fence: complete/release only act when the caller's token still owns the row,
  /// so a concurrent reclaimer can't clobber another request's active claim (review 052).
  leaseToken  String?
  statusCode  Int?
  response    Json?
  lockedAt    DateTime @default(now())
  expiresAt   DateTime // lease + GC horizon
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@id([scope, route, key])
  @@index([expiresAt])
  @@index([createdAt])
}

/// The server-side record of what the API told a wallet to sign. `POST /transactions/
/// track` diffs the mined tx against this (selector + decoded argsHash). Pre-hash
/// lifecycle lives here (PREPARED → SUBMITTED → ABANDONED); post-hash on TrackedTransaction.
model PreparedIntent {
  preparedId   String   @id @default(uuid())
  /// The prepare's Idempotency-Key. Caller-scoped (unique per (scope, key)) so one caller's key can
  /// never return another caller's intent — the raw header is client-controlled (review 053).
  idempotencyKey String
  scope        String // lowercased session address that prepared it
  action       String // TxAction
  functionName String
  to           String // expected contract (lowercased)
  selector     String // 0x-8-hex expected selector
  argsHash     String // keccak256 of canonical decoded args
  chainId      Int
  jobRequestId String?
  jobId        String?
  status       String   @default("PREPARED") // PREPARED | SUBMITTED | ABANDONED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trackedTx TrackedTransaction?

  @@unique([scope, idempotencyKey])
}

/// A submitted onchain tx the API verifies + mirrors (one-directional). Keyed by the
/// lowercased txHash (makes track idempotent). `prepareKey` + partial-unique
/// UNIQUE(prepareKey) WHERE action='OPEN_JOB' is the DB backstop for the double-fund bind.
model TrackedTransaction {
  txHash           String   @id // lowercased 0x-64
  prepared         PreparedIntent? @relation(fields: [preparedId], references: [preparedId], onDelete: SetNull)
  preparedId       String?  @unique
  prepareKey       String? // == PreparedIntent.idempotencyKey; partial-unique for OPEN_JOB
  job              JobMetadata? @relation(fields: [jobRequestId], references: [clientRequestId], onDelete: SetNull)
  jobRequestId     String?
  jobId            String?
  chainId          Int
  toAddress        String
  functionSelector String
  action           String // TxAction
  status           String   @default("PENDING") // PENDING|CONFIRMED|FAILED|MISMATCH|REORGED
  confirmations    Int      @default(0)
  blockNumber      BigInt?
  eventVerified    Boolean  @default(false)
  lastCheckedAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([jobRequestId])
  @@index([jobId])
  @@index([prepareKey])
}

/// Append-only, non-secret activity feed for the dashboard. Immutable at the APP layer
/// (only appendFeedEvent writes; no update/delete endpoint) — not DB-revoked, so demo
/// reset can DELETE it on the app role (review 060). `payload` is allowlisted + redacted;
/// any money-shaped values are display mirrors of chain events, never decided on.
model FeedEvent {
  id            String   @id @default(uuid())
  job           JobMetadata? @relation(fields: [jobRequestId], references: [clientRequestId], onDelete: Cascade)
  jobRequestId  String?
  kind          String // FeedEventKind
  correlationId String?
  payload       Json
  at            DateTime @default(now())

  @@index([jobRequestId, at])
  @@index([at])
}

/// Offchain-origin notification bookkeeping (NOT rebuildable from chain).
model NotificationState {
  id            String      @id @default(uuid())
  job           JobMetadata @relation(fields: [jobRequestId], references: [clientRequestId], onDelete: Cascade)
  jobRequestId  String
  channel       String
  statusTrigger String
  sent          Boolean     @default(false)
  createdAt     DateTime    @default(now())

  // A reorg-induced status flap must not double-send.
  @@unique([jobRequestId, channel, statusTrigger])
}

/// Offchain-origin structured log of autonomous agent actions (NOT rebuildable).
/// `structuredLog` must be redacted of any secret-shaped content before persist.
model AgentRunLog {
  id            String      @id @default(uuid())
  job           JobMetadata @relation(fields: [jobRequestId], references: [clientRequestId], onDelete: Cascade)
  jobRequestId  String
  action        String // "quote" | "monitor"
  structuredLog Json
  at            DateTime    @default(now())
}

// =============================================================================
// Agent risk-quotation & settlement operational store (plan §9.1)
//
// These are the agent's OWN advisory quote + payment-execution records — NOT
// authoritative money/reputation state (that stays onchain + in The Graph).
// Amounts are 6-dec USDC base-unit STRINGS; the daily-cap SUM casts with
// `amount::numeric` under a per-wallet advisory lock (see quotesRepo; plan §0.5).
// =============================================================================

/// A signed, expiring quote the agent issued (plan §5). `quoteId == nonce`.
model Quote {
  quoteId                   String   @id // bytes32 hex; also the replay/escrow nonce
  jobHash                   String // keccak256 of canonicalized job terms (anti-tamper)
  provider                  String
  scoringFnVersion          String
  premiumBps                Int
  recommendedGuaranteeLimit String
  assuranceServiceFee       String
  minProviderCollateral     String
  confidenceLevel           String
  reasonCodes               String[]
  signature                 String
  validAfter                BigInt
  expiresAt                 BigInt
  asOfBlock                 BigInt
  /// Full signed QuoteCommitment (non-authoritative operational record) for exact reconstruction —
  /// the flat columns above are for querying/indexing/the dashboard.
  raw                       Json
  createdAt                 DateTime @default(now())

  intents   PaymentIntent[]
  traces    DecisionTrace[]
  usedNonce UsedNonce?
}

/// Crash-safe payment-execution intent (plan §6.4). `idempotencyKey` is a
/// deterministic uuidv5; `paramsHash` guards against stale-amount reuse under a
/// fixed key. OnDelete:Restrict — an audit/ledger row is never cascade-deleted.
model PaymentIntent {
  idempotencyKey String   @id
  quote          Quote    @relation(fields: [quoteId], references: [quoteId], onDelete: Restrict)
  quoteId        String
  action         String // POST_BOND | REFUND_BOND
  amount         String
  token          String
  destination    String // the escrow contract address
  callData       String // viem-encoded contract call (postBond/refundBond) — replayed on reconcile
  chainId        Int
  paramsHash     String
  status         String   @default("PLANNED") // PLANNED|SUBMITTING|SUBMITTED|CONFIRMED|FAILED|ABANDONED
  providerRef    String?
  txHash         String?
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Rolling-24h cap SUM reads non-terminal intents (see quotesRepo.reserveIntent). A partial index
  // `("createdAt") WHERE status NOT IN ('FAILED','ABANDONED')` backs it, added via raw migration SQL
  // (Prisma can't express partial indexes — see manual/001-agent-constraints.sql).
  @@index([status])
  @@index([createdAt])
}

/// Append-only, per-quote hash-chained decision log (plan §9.1). The dual
/// UNIQUE constraints DB-enforce chain linearization so concurrent writers can't
/// fork the chain (data-integrity H1). Revoke UPDATE/DELETE at the DB role.
model DecisionTrace {
  id             String   @id @default(uuid())
  quote          Quote    @relation(fields: [quoteId], references: [quoteId], onDelete: Restrict)
  quoteId        String
  seq            Int
  correlationId  String
  outcome        String // QUOTED | BOND_POSTED | BOND_REFUNDED | REJECTED
  reasonCodes    String[]
  scoreInputs    Json // allowlisted fields only — never raw request/config blobs
  txHash         String?
  prevRecordHash String
  recordHash     String
  createdAt      DateTime @default(now())

  @@unique([quoteId, prevRecordHash])
  @@unique([quoteId, seq])
}

/// Single consumption authority for a quote's nonce (plan §5). Consumed at
/// ACTION time via INSERT ... ON CONFLICT DO NOTHING (atomic replay defense).
model UsedNonce {
  nonce   String   @id // == quoteId
  quote   Quote    @relation(fields: [quoteId], references: [quoteId], onDelete: Restrict)
  quoteId String   @unique
  usedAt  DateTime @default(now())
}
