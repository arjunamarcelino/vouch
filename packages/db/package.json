{
  "name": "@vouch/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "codegen": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:constraints": "psql \"$DATABASE_URL\" -v app_role=\"${APP_DB_ROLE:-vouch_app}\" -f prisma/manual/001-agent-constraints.sql"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@vouch/config": "workspace:*",
    "prisma": "^7.10.0"
  }
}
