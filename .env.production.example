# =============================================================================
# Vouch — PRODUCTION deploy template for the withvouch.xyz domain scheme.
#   web   → https://withvouch.xyz          (Vercel; set NEXT_PUBLIC_* as BUILD-TIME env)
#   api   → https://api.withvouch.xyz      (container host)
#   agent → https://agent.withvouch.xyz    (container host; prefer PRIVATE/api-only networking)
# Real secrets live in the platform secret store (Vercel/host), NEVER in this file or an image layer.
# Split per service as needed. See docs/deployment-hosting.md.
# =============================================================================

CHAIN_ENV=arc-mainnet          # Arc Microgrants: live on Arc mainnet (chain 5042)
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.drpc.mainnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000
VOUCH_CORE_ADDRESS=0xB30e054557533f28753B4ACdf646B393E2072bf9        # same address on both chains (deterministic CREATE)
QUOTE_BOND_ESCROW_ADDRESS=0x3ca2d854d5f042dd0ddd39eaf80644be0e80048c
VOUCH_DEPLOY_BLOCK=25456280
# (testnet reference: CHAIN_ENV=arc-testnet ARC_CHAIN_ID=5042002 ARC_RPC_URL=https://rpc.testnet.arc.io VOUCH_DEPLOY_BLOCK=61747921)

# ---- Graph Studio (read endpoint + required freshness pins) ----
# ⚠️ UNSET on mainnet: the live v0.0.2 subgraph indexes Arc TESTNET. Pointing a mainnet app at it
# makes the freshness/chain gate refuse every quote. Leave blank until a mainnet subgraph is deployed;
# the agent quote path then fail-closes (503) while the core job/escrow/claim flow works normally.
SUBGRAPH_URL=
SUBGRAPH_DEPLOYMENT_ID=
GRAPH_DEPLOY_KEY=            # only for `graph deploy`; keep in the deploy CI secret store, not here

# ---- api (api.withvouch.xyz) ----
PORT=3001
# Exact CORS allowlist (comma-separated). credentials:true → no wildcard, exact match only.
WEB_ORIGIN=https://withvouch.xyz
SIWE_DOMAIN=withvouch.xyz
SESSION_SECRET=            # 32+ random; platform secret store
AGENT_URL=https://agent.withvouch.xyz
AGENT_API_KEY=            # shared Bearer, identical on api + agent; platform secret store
DATABASE_URL=            # managed Postgres DSN; platform secret store

# ---- agent (agent.withvouch.xyz) — SINGLE instance, no scale-to-zero/autoscale ----
AGENT_HTTP_PORT=3002
AGENT_ALLOW_MANUAL_PAY=false   # must stay false outside development
# Circle Agent Stack — real values in the platform secret store, NEVER here. Fund the wallet at/below
# the daily cap and configure Circle-side spend controls (the entity secret bypasses in-process caps).
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
AGENT_WALLET_ID=
AGENT_USDC_TOKEN_ID=
QUOTE_SIGNER_PK=

# ---- web (withvouch.xyz) — set these as Vercel BUILD-TIME env (inlined into the bundle) ----
NEXT_PUBLIC_CHAIN_ENV=arc-mainnet
NEXT_PUBLIC_API_BASE_URL=https://api.withvouch.xyz
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.drpc.mainnet.arc.io
NEXT_PUBLIC_SUBGRAPH_URL=       # unset on mainnet (see subgraph note above)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
