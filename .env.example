# =============================================================================
# Vouch — shared / default environment template
# Copy to .env and fill in. NEVER commit real values. NEVER put private tests,
# evaluation criteria, repo credentials, or secrets in Postgres or onchain.
# =============================================================================

# Which environment profile to load: development | arc-testnet | arc-mainnet
CHAIN_ENV=development

# ---- Offchain operational DB (Prisma / Postgres) — operational data ONLY ----
DATABASE_URL=postgresql://vouch:vouch@localhost:5432/vouch?schema=public

# ---- The Graph (server-only unless prefixed NEXT_PUBLIC_) ----
# Deployed subgraph GraphQL endpoint the api/agent query for live reputation data.
SUBGRAPH_URL=http://localhost:8000/subgraphs/name/vouch/vouch-subgraph
# Deployment CID (Qm…) — the trust-root pin. Freshness refuses if _meta.deployment differs.
# REQUIRED whenever SUBGRAPH_URL is set (config load fails otherwise).
SUBGRAPH_DEPLOYMENT_ID=
# Index-node status endpoint (graph-node :8030 or provider status URL) for indexing-lag health checks.
SUBGRAPH_STATUS_URL=
# Fail-closed freshness budget: refuse a quote if the subgraph is more than this many blocks behind
# the chain head, or its indexed block is older than this many seconds while also block-behind.
SUBGRAPH_MAX_LAG_BLOCKS=25
SUBGRAPH_MAX_STALENESS_SECONDS=180
# JSON-RPC endpoint — REQUIRED whenever SUBGRAPH_URL is set (the lag gate reads the chain head from it;
# no RPC ⇒ freshness unverifiable ⇒ the api/agent fail closed and refuse to quote).
ARC_RPC_URL=
# Studio deploy key (server-only; only needed when deploying a subgraph). Leave blank locally.
# NEVER prefix this NEXT_PUBLIC_. NEVER echo it in CI.
GRAPH_DEPLOY_KEY=

# ---- Public frontend config (safe to expose) ----
# Only the READ endpoint may be public. The fail-closed freshness gate is server-side, so apps/web
# must NOT render guarantee-relevant numbers directly from this URL — route them through apps/api.
NEXT_PUBLIC_CHAIN_ENV=development
NEXT_PUBLIC_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/vouch/vouch-subgraph
