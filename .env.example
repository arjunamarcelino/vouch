# =============================================================================
# Vouch — shared / default environment template
# Copy to .env and fill in. NEVER commit real values. NEVER put private tests,
# evaluation criteria, repo credentials, or secrets in Postgres or onchain.
# =============================================================================

# Which environment profile to load: development | arc-testnet | arc-mainnet
CHAIN_ENV=development

# ---- Offchain operational DB (Prisma / Postgres) — operational data ONLY ----
DATABASE_URL=postgresql://vouch:vouch@localhost:5432/vouch?schema=public

# ---- The Graph ----
# Deployed subgraph GraphQL endpoint the web/agent query for live reputation data.
SUBGRAPH_URL=http://localhost:8000/subgraphs/name/vouch/vouch-subgraph
# Studio deploy key (only needed when deploying a subgraph). Leave blank locally.
GRAPH_DEPLOY_KEY=

# ---- Public frontend config (safe to expose) ----
NEXT_PUBLIC_CHAIN_ENV=development
NEXT_PUBLIC_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/vouch/vouch-subgraph
