# =============================================================================
# Vouch — development environment template
# Local anvil / local graph-node / local Postgres. No real funds, no real secrets.
# =============================================================================

CHAIN_ENV=development

# Local EVM (anvil) or Arc testnet RPC for local work.
ARC_RPC_URL=http://127.0.0.1:8545

# Offchain operational DB.
DATABASE_URL=postgresql://vouch:vouch@localhost:5432/vouch?schema=public

# Local subgraph (graph-node) endpoint.
SUBGRAPH_URL=http://localhost:8000/subgraphs/name/vouch/vouch-subgraph
# Local graph-node index-node status endpoint (indexing-lag health checks).
SUBGRAPH_STATUS_URL=http://localhost:8030/graphql
SUBGRAPH_DEPLOYMENT_ID=
# Fail-closed freshness budget (ARC_RPC_URL above is required when SUBGRAPH_URL is set).
SUBGRAPH_MAX_LAG_BLOCKS=25
SUBGRAPH_MAX_STALENESS_SECONDS=180
NEXT_PUBLIC_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/vouch/vouch-subgraph
NEXT_PUBLIC_CHAIN_ENV=development
