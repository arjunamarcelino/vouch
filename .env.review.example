# =============================================================================
# Vouch — ONE-COMMAND REVIEW profile.  `cp .env.review.example .env.review`
# Boots the docker-compose stack against LIVE Arc testnet + LIVE Graph Studio.
# Public coordinates only. NEVER put real secrets here — key-type vars stay placeholders.
# Review at http://localhost:3000 ONLY (the __Host- session cookie needs a Secure context).
# =============================================================================

# arc-testnet (NOT development): the __Host- session cookie must be Secure; on http://localhost that
# is a trustworthy context, so login works — but a LAN IP over http will reject the cookie.
CHAIN_ENV=arc-testnet
NEXT_PUBLIC_CHAIN_ENV=arc-testnet
ARC_CHAIN_ID=5042002

# ---- Live Arc testnet (official) ----
ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000
VOUCH_CORE_ADDRESS=0xB30e054557533f28753B4ACdf646B393E2072bf9
QUOTE_BOND_ESCROW_ADDRESS=0x3ca2d854d5f042dd0ddd39eaf80644be0e80048c
VOUCH_DEPLOY_BLOCK=61747921

# ---- Live Graph Studio subgraph (read endpoint; RPC + deployment id are REQUIRED with it) ----
SUBGRAPH_URL=https://api.studio.thegraph.com/query/1760065/vouch/v0.0.2
SUBGRAPH_DEPLOYMENT_ID=QmaoAwseMjoD3EMFwhQf3KBqqyac7sa4anpUBxK7iwEM8p
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1760065/vouch/v0.0.2
# Only needed to DEPLOY a subgraph; leave blank for review.
GRAPH_DEPLOY_KEY=

# ---- API <-> Agent (compose overrides the hosts; keep these for non-docker `pnpm dev` review) ----
AGENT_URL=http://localhost:3002
# Shared Bearer between api and agent. arc-testnet is fail-closed, so this MUST be set on BOTH — the
# placeholder below works for local review (both services read this same file). Change for anything public.
AGENT_API_KEY=changeme-shared-review-agent-key

# ---- Session / SIWE / CORS (required outside development) ----
SESSION_SECRET=changeme-changeme-changeme-change-32plus
SIWE_DOMAIN=localhost:3000
WEB_ORIGIN=http://localhost:3000

# ---- Postgres (compose sets the in-cluster bare DSN; this is the fallback for `pnpm dev`) ----
DATABASE_URL=postgresql://vouch:vouch@localhost:5432/vouch

# ---- Circle Agent Stack (OPTIONAL for a browse/read review). Leave blank → the agent boots and
#      surfaces an explicit "not configured" state for wallet ops (it never fakes a tx). Fill only to
#      demo real USDC bond posting. NEVER commit real values. ----
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
AGENT_WALLET_ID=
AGENT_USDC_TOKEN_ID=
QUOTE_SIGNER_PK=
# Manual-pay MUST stay false outside development (moves real USDC via /quotes/:id/pay).
AGENT_ALLOW_MANUAL_PAY=false

# ---- WalletConnect (browser wallet connect; optional for read-only browse) ----
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
