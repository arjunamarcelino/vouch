{
  "name": "vouch",
  "version": "0.0.0",
  "private": true,
  "description": "Vouch — confidential post-completion outcome-assurance protocol for AI-agent work",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "turbo run codegen",
    "test": "turbo run test",
    "test:contracts": "turbo run test:contracts --filter=@vouch/contracts",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "gate:secrets": "node scripts/secret-scan.mjs",
    "demo:health": "node scripts/preflight-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "catalog:"
  }
}
