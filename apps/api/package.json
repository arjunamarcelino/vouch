{
  "name": "@vouch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import @swc-node/register/esm-register --test 'src/**/*.test.ts'",
    "test:db": "node test/db-harness.mjs",
    "demo": "node --import @swc-node/register/esm-register scripts/demo.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@vouch/db": "workspace:*",
    "@vouch/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "nestjs-zod": "^5.5.0",
    "p-retry": "^6.2.1",
    "p-timeout": "^6.1.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "@vouch/config": "workspace:*",
    "supertest": "^7.2.2"
  }
}
