# =============================================================================
# Vouch — Arc TESTNET environment template
# Arc Testnet chain id 5042002. USDC is the native gas token.
# ⚠️ Confirm the RPC host before use: rpc.testnet.arc.network (Circle skill) vs
#    rpc.testnet.arc.io (docs.arc.io). See plan §17.1.
# =============================================================================

CHAIN_ENV=arc-testnet

# ---- Arc chain ----
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app
# USDC ERC-20 (6 decimals) on Arc. Confirm at docs.arc.io/arc/references/contract-addresses.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- Contract deploy (Foundry) — use an encrypted keystore, not a raw key, for anything real ----
DEPLOYER_PK=
KEYSTONE_FORWARDER=
COVERAGE_WINDOW=86400

# ---- Circle Agent Stack (agent wallet) ----
# Register the entity secret as ciphertext via Circle's flow; do not paste a long-lived raw secret.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Wallet created on ARC-TESTNET + the Circle token id for USDC on that chain.
AGENT_WALLET_ID=
AGENT_USDC_TOKEN_ID=

# ---- Agent quotation & settlement (apps/agent) ----
# Dedicated quote-signing key — MUST differ from the payment wallet (never log; redacted).
QUOTE_SIGNER_PK=
# QuoteBondEscrow (Track D) address, or leave unset to use the custody-transfer fallback.
QUOTE_BOND_ESCROW_ADDRESS=
AGENT_QUOTE_BOND_AMOUNT=1000000          # 1 USDC (6-dec) bond per quote
# Spend policy (defense-in-depth; Circle-side spending controls are the PRIMARY limit — ADR-008).
AGENT_PER_TX_CAP=1000000
AGENT_DAILY_CAP=10000000
AGENT_DEST_ALLOWLIST=                     # comma-separated: only the escrow/custody address
AGENT_HTTP_PORT=3002
AGENT_ALLOW_MANUAL_PAY=false              # true only for demos/tests (exposes /pay + MCP execute_payment)
QUOTE_TTL_SECONDS=300

# ---- The Graph (server-only unless prefixed NEXT_PUBLIC_) ----
SUBGRAPH_URL=
# Deployment CID (Qm…) from `graph deploy` — trust-root pin (freshness refuses on mismatch).
SUBGRAPH_DEPLOYMENT_ID=
# Index-node status endpoint for indexing-lag health checks (health-check.mjs).
SUBGRAPH_STATUS_URL=
# Fail-closed freshness budget (ARC_RPC_URL above is REQUIRED when SUBGRAPH_URL is set).
SUBGRAPH_MAX_LAG_BLOCKS=25
SUBGRAPH_MAX_STALENESS_SECONDS=180
# Studio deploy key — server-only; never NEXT_PUBLIC_, never echoed in CI.
GRAPH_DEPLOY_KEY=
# Free-text version label for `graph deploy --version-label`.
SUBGRAPH_VERSION=v0.0.1
# Only the READ endpoint is public; web must not render guarantee numbers straight from it.
NEXT_PUBLIC_SUBGRAPH_URL=
NEXT_PUBLIC_CHAIN_ENV=arc-testnet

# ---- Offchain operational DB ----
DATABASE_URL=postgresql://vouch:vouch@localhost:5432/vouch?schema=public

# ---- Agent LLM (optional; the agent must NEVER receive private tests/criteria/creds) ----
ANTHROPIC_API_KEY=
